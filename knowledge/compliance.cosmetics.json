  "promptRules": {
    "_comment": "Category-specific generation guidance injected into the prompts.",
    "_complianceComment": "The COMPLIANCE headline rules. These used to be hard-coded English sentences inside lib/engine/prompts/system.ts; they are pack data now so the engine carries no category rule text.",
    "compliance": [
      "NEVER claim to diagnose, treat, cure, prevent, or mitigate any disease, skin condition or symptom — a cosmetic may only describe appearance and feel.",
      "NEVER claim the product replaces, matches, or acts like a prescription drug or an in-office medical procedure.",
      "No star-rating or review-count claims.",
      "No price, discount, shipping or availability statement in copy."
    ],
    "system": [
      "Do NOT write the disclaimer anywhere — the system inserts the verbatim constant itself. Claim-bearing bullets end with a trailing \"*\" marker only.",
      "If an allergen is present, declare it exactly as \"Contains: [Allergen]\" consistently; never write \"No Known Allergens\" when one is present."
    ],
    "attributes": [
      "\"ingredients\": the full INCI label list, in label order.",
      "\"allergen_information\": exact canonical string if an allergen is present, else \"Free from major allergens per label\" ONLY if the label says so, else omit."
    ],
    "bullets": [
      "One bullet must declare the allergen (\"Contains: ...\") if any allergen is present in the ingredients; if none, one bullet covers quality/testing signals instead."
    ],
    "description": [
      "Cover: what it is, who it's for, how to use, quality/safety (including \"Contains: [Allergen]\" if applicable and a short safety note: patch-test / discontinue use if irritation occurs / keep out of reach of children)."
    ],
    "qa": [
      "Cover: usage, routine placement, who it's for, skin/hair suitability and allergens, storage, what makes it different, results expectations (compliant phrasing)."
    ],
    "aplus": [
      "In the ingredients/feature module, declare \"Contains: [Allergen]\" if an allergen is applicable."
    ]
  }

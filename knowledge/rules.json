  "prohibitedContent": {
    "_comment": "Amazon bans price/availability/condition details and contact info in titles, bullets, descriptions, backend and images (A+ included). Patterns are pack data; the gate reads them.",
    "patterns": [
      [
        "\\$\\s*\\d",
        "price ($ figure)"
      ],
      [
        "\\b\\d+(?:[.,]\\d+)?\\s*(?:dollars?|cents?|usd|bucks|quid|euros?)\\b",
        "price (spelled-out currency)"
      ],
      [
        "\\b(?:dollars?|cents?)\\s+and\\s+\\d",
        "price (spelled-out currency)"
      ],
      [
        "\\bprice[ds]?\\s+at\\b",
        "price statement"
      ],
      [
        "\\b(?:msrp|retail price|sale price|list price|regular price|our price)\\b",
        "price statement"
      ],
      [
        "\\b\\d{1,3}\\s*%\\s*off\\b",
        "discount claim"
      ],
      [
        "\\b(?:discount|coupon|promo code|percent off)\\b",
        "promotional claim"
      ],
      [
        "\\bfree shipping\\b",
        "shipping offer"
      ],
      [
        "\\b(?:in stock|out of stock|back ?order|ships? (?:today|tomorrow)|limited stock)\\b",
        "availability claim"
      ],
      [
        "\\b(?:brand new|like new|refurbished|pre-?owned|open box)\\b",
        "condition claim"
      ],
      [
        "\\b[\\w.+-]+@[\\w-]+\\.[\\w.]{2,}\\b",
        "email address"
      ],
      [
        "\\b(?:https?://|www\\.)[^\\s]+",
        "website URL"
      ],
      [
        "\\b(?:\\+?1[\\s.-]?)?\\(?\\d{3}\\)?[\\s.-]\\d{3}[\\s.-]\\d{4}\\b",
        "phone number"
      ],
      [
        "\\b[\\w-]{2,}\\.(?:com|net|org|co|io|shop|store|us)\\b",
        "website URL (bare domain)"
      ],
      [
        "\\b\\d{10}\\b",
        "phone number (unseparated)"
      ],
      [
        "\\b(?:one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|twenty|thirty|forty|fifty|sixty|seventy|eighty|ninety|hundred)[\\s-]?(?:\\w+[\\s-])?(?:dollars?|cents?|bucks|quid)\\b",
        "price (spelled-out currency)"
      ],
      [
        "\\bhalf price\\b",
        "discount claim"
      ],
      [
        "\\btwo for one\\b",
        "promotional claim"
      ],
      [
        "\\bbogo\\b",
        "promotional claim"
      ],
      [
        "[£¥₹₩¢₽₴]\\s*\\d",
        "price (non-USD currency symbol)"
      ],
      [
        "\\+\\d{1,3}[\\s.-]?\\d{2,4}[\\s.-]?\\d{3,4}[\\s.-]?\\d{3,4}",
        "phone number (international format)"
      ],
      [
        "[\\w.-]+\\s*(?:\\[at\\]|\\(at\\)|\\sat\\s)\\s*[\\w.-]+\\s*(?:\\[dot\\]|\\(dot\\)|\\sdot\\s)\\s*(?:com|net|org|io)",
        "email address (obfuscated)"
      ],
      [
        "per[- ](?:bottle|unit|serving|month)\\s+(?:cost|price)",
        "price statement (per-unit cost framing)"
      ]
    ],

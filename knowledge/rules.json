  "prohibitedMarketing": {
    "_comment": "Amazon-prohibited MARKETING claims: urgency, guarantees, rank/best-seller, star ratings, review counts and false regulatory-approval claims. PACK DATA — gate A8 (A+ surfaces) and C19 (every surface) read these patterns; the gate holds no literal marketing lexicon. C19 additionally scans compliancePack.superlativeBans. GUARANTEE PATTERNS target the CLAIM, not the word: \"money back guarantee\", \"satisfaction guaranteed\", \"guaranteed results\", \"results guaranteed\", \"lifetime guarantee\" and the first-person promise \"we/our guarantee\" all fail, while the bare noun in a non-promissory sentence (an image brief that says \"no guarantees or claims on pack\") does not. A bare \\bguarantee[ds]?\\b flagged every sense of the word and was a live false positive on ordinary copy. Note \"we cannot guarantee ...\" is deliberately NOT matched: only a positive first-person promise is a guarantee claim.",
    "patterns": [
      [
        "\\$\\s*\\d",
        "price / $ figure"
      ],
      [
        "\\b(?:cents?|dollars?)\\s+(?:a|per)\\s+day\\b",
        "per-day price framing"
      ],
      [
        "\\bbuy\\s+now\\b",
        "\"buy now\" CTA"
      ],
      [
        "\\bshop\\s+now\\b",
        "\"shop now\" CTA"
      ],
      [
        "\\border\\s+(?:now|today)\\b",
        "urgency CTA"
      ],
      [
        "\\bsubscribe\\s*(?:&|and)\\s*save\\b",
        "\"subscribe & save\""
      ],
      [
        "\\bhurry\\b",
        "urgency"
      ],
      [
        "\\btoday\\s+only\\b",
        "urgency"
      ],
      [
        "\\blimited\\s+time\\b",
        "urgency"
      ],
      [
        "\\bwhile\\s+supplies\\s+last\\b",
        "urgency"
      ],
      [
        "\\bact\\s+(?:now|fast)\\b",
        "urgency"
      ],
      [
        "\\bmoney[- ]back\\b",
        "guarantee"
      ],
      [
        "\\b(?:100\\s*%|full|lifetime|unconditional|iron[- ]?clad|no[- ]questions[- ]asked|price|happiness|refund|money[- ]back)\\s+guarantee[ds]?\\b",
        "guarantee"
      ],
      [
        "\\bguarantee[ds]?\\s+(?:results?|relief|satisfaction|success|delivery|weight\\s+loss|to\\s+\\w+)\\b",
        "guarantee"
      ],
      [
        "\\b(?:results?|satisfaction|relief|success|effectiveness|delivery)\\s+guaranteed\\b",
        "guarantee"
      ],
      [
        "\\b(?:we|our)\\s+(?:100%\\s+|fully\\s+|proudly\\s+|absolutely\\s+)?guarantee\\b",
        "guarantee"
      ],
      [
        "#\\s?1\\b",
        "\"#1\" claim"
      ],
      [
        "\\bbest[- ]?sell(?:er|ing)\\b",
        "best-seller claim"
      ],
      [
        "\\btop[- ]?rated\\b",
        "ranking claim"
      ],
      [
        "\\b\\d(?:\\.\\d)?\\s*[- ]?star\\b",
        "star-rating claim"
      ],
      [
        "\\b[\\d,]+\\+?\\s*(?:customer\\s+)?reviews\\b",
        "review-count claim"
      ],
      [
        "\\bfda[- ]approved\\b",
        "false regulatory-approval claim"
      ],
      [
        "\\btop[- ]?selling\\b",
        "best-seller claim"
      ],
      [
        "\\bnumber one rated\\b",
        "ranking claim"
      ],
      [
        "\\brisk[- ]free\\b",
        "guarantee"
      ],
      [
        "\\bsatisfaction\\s+(?:assured|guaranteed)\\b",
        "guarantee"
      ],
      [
        "\\b(?:doctor|physician|dermatologist|pharmacist)\\s+recommended\\b",
        "authority-endorsement claim"
      ],
      [
        "\\baward[- ]winning\\b",
        "award/ranking claim"
      ],
      [
        "\\bas seen on tv\\b",
        "media-endorsement claim"
      ],
      [
        "\\bclinically\\s+studied\\b",
        "clinical-endorsement claim (borderline: legitimate when substantiated, banned here because Amazon treats unsubstantiated clinical framing as a prohibited claim)"
      ]
    ],
    "surfaces": [
      "title",
      "title75",
      "itemHighlights",
      "bullets",
      "description",
      "backendSearchTerms",
      "qa",
      "imagePlan",
      "attributes",
